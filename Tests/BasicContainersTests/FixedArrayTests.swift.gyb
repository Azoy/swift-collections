%{
  from gyb_utils import (autogenerated_warning, capacities, layouts)
}%
${autogenerated_warning()}

import XCTest
#if COLLECTIONS_SINGLE_MODULE
import Collections
#else
import _CollectionsTestSupport
import SpanPreview
import ContainersPreview
import BasicContainers
#endif

#if compiler(>=6.2)

/// Check if `left` and `right` contain equal elements in the same order.
@available(SwiftStdlib 6.2, *)
internal func expectFixedArrayContents<
  let capacity: Int,
  Element: Equatable,
  C2: Collection<Element>,
>(
  _ left: borrowing FixedArray<capacity, Element>,
  equalTo right: C2,
  _ message: @autoclosure () -> String = "",
  trapping: Bool = false,
  file: StaticString = #filePath,
  line: UInt = #line
) {
  expectIterableContents(
    left.span,
    equalTo: right,
    message(), trapping: trapping, file: file, line: line)
}

/// Check if `left` and `right` contain equal elements in the same order.
@available(SwiftStdlib 6.2, *)
internal func expectFixedArrayContents<
  let capacity: Int,
  E1: ~Copyable,
  C2: Collection,
>(
  _ left: borrowing FixedArray<capacity, E1>,
  equivalentTo right: C2,
  by areEquivalent: (borrowing E1, C2.Element) -> Bool,
  printer: (borrowing E1) -> String,
  _ message: @autoclosure () -> String = "",
  trapping: Bool = false,
  file: StaticString = #filePath,
  line: UInt = #line
) {
  expectIterableContents(
    left.span,
    equivalentTo: right,
    by: areEquivalent,
    printer: printer,
    message(), trapping: trapping, file: file, line: line)
}

@available(SwiftStdlib 6.2, *)
class FixedArrayTests: CollectionTestCase {
  func test_memory_layout() {
    let word = MemoryLayout<Int>.size
    
    expectEqual(MemoryLayout<FixedArray<1, Int>>.stride, 2 * word)
    // No place to stick the optional bit.
    expectEqual(MemoryLayout<FixedArray<1, Int>?>.stride, 3 * word)
  }
  
  func test_basics() {
    withLifetimeTracking { tracker in
      typealias Value = LifetimeTrackedStruct<Int>

      var array = FixedArray<2, Value>()
      expectTrue(array.isEmpty)
      expectEqual(array.count, 0)
      expectEqual(array.capacity, 2)
      expectEqual(tracker.instances, 0)

      array.append(tracker.structInstance(for: 10))
      expectFalse(array.isEmpty)
      expectEqual(array.count, 1)
      expectEqual(array.capacity, 2)
      expectEqual(array[0].payload, 10)
      expectEqual(tracker.instances, 1)

      array.append(tracker.structInstance(for: 20))
      expectFalse(array.isEmpty)
      expectEqual(array.count, 2)
      expectEqual(array.capacity, 2)
      expectEqual(array[0].payload, 10)
      expectEqual(array[1].payload, 20)
      expectEqual(tracker.instances, 2)

      let old = array.remove(at: 0)
      expectEqual(old.payload, 10)
      expectFalse(array.isEmpty)
      expectEqual(array.count, 1)
      expectEqual(array.capacity, 2)
      expectEqual(array[0].payload, 20)
      expectEqual(tracker.instances, 2)
      _ = consume old
      expectEqual(tracker.instances, 1)

      let old2 = array.remove(at: 0)
      expectEqual(old2.payload, 20)
      expectEqual(array.count, 0)
      expectEqual(array.capacity, 2)
      expectTrue(array.isEmpty)
      expectEqual(tracker.instances, 1)
      _ = consume old2
      expectEqual(tracker.instances, 0)
    }
  }
  
  func test_init() {
% for capacity in capacities:
    do {
      let a = FixedArray<${capacity}, Int>()
      expectEqual(a.capacity, ${capacity})
      expectEqual(a.count, 0)
      expectEqual(a.freeCapacity, ${capacity})
      expectTrue(a.isEmpty)
    }
% end
  }
  
  func test_init_repeating() {
% for (capacity, count) in layouts:
    do {
      withLifetimeTracking { tracker in
        let value = tracker.instance(for: 0)
        let a = FixedArray<${capacity}, _>(repeating: value, count: ${count})
        expectEqual(a.capacity, ${capacity})
        expectEqual(a.count, ${count})
        expectEqual(a.freeCapacity, ${capacity} - ${count})
        expectEqual(a.isEmpty, ${count} == 0)
        for i in 0 ..< ${count} {
          expectIdentical(a[i], value)
        }
      }
    }
% end
  }
  
  func test_append() {
% for (capacity, count) in layouts:
    do {
      withLifetimeTracking { tracker in
        let layout = ArrayLayout(capacity: ${capacity}, count: ${count})
        var a = FixedArray<${capacity}, _>(layout: layout) { tracker.instance(for: $0) }
        for i in layout.count ..< layout.capacity {
          a.append(tracker.instance(for: i))
          expectEqual(a.count, i + 1)
          expectFixedArrayContents(
            a,
            equivalentTo: 0 ..< i + 1,
            by: { $0.payload == $1 },
            printer: { "\($0.payload)" })
        }
        expectTrue(a.isFull)
        expectEqual(tracker.instances, layout.capacity)
      }
    }
% end
  }

  func test_pushLast() {
% for (capacity, count) in layouts:
    do {
      withLifetimeTracking { tracker in
        let layout = ArrayLayout(capacity: ${capacity}, count: ${count})
        var a = FixedArray<${capacity}, _>(layout: layout) { tracker.instance(for: $0) }
        for i in layout.count ..< layout.capacity {
          expectNil(a.pushLast(tracker.instance(for: i)))
          expectEqual(a.count, i + 1)
          expectFixedArrayContents(
            a,
            equivalentTo: 0 ..< i + 1,
            by: { $0.payload == $1 },
            printer: { "\($0.payload)" })
        }
        expectTrue(a.isFull)
        let final = a.pushLast(tracker.instance(for: layout.capacity))
        expectNotNil(final) { value in
          expectEqual(value.payload, layout.capacity)
        }
      }
    }
% end
  }

  func test_append_addingCount_full() {
% for (capacity, count) in layouts:
    do {
      let layout = ArrayLayout(capacity: ${capacity}, count: ${count})
      withEvery("c", in: 0 ..< layout.freeCapacity) { c in
        withLifetimeTracking { tracker in
          var a = FixedArray<${capacity}, _>(layout: layout) { tracker.instance(for: $0) }
          a.append(addingCount: c) { target in
            expectEqual(target.freeCapacity, c)
            for i in 0 ..< c {
              target.append(tracker.instance(for: layout.count + i))
            }
          }
          expectFixedArrayContents(
            a,
            equivalentTo: 0 ..< layout.count + c,
            by: { $0.payload == $1 },
            printer: { "\($0.payload)" })
        }
      }
    }
% end
  }

  func test_append_addingCount_partial() {
% for (capacity, count) in layouts:
    do {
      let layout = ArrayLayout(capacity: ${capacity}, count: ${count})
      guard layout.freeCapacity > 0 else { return }
      withEvery("c", in: 1 ..< layout.freeCapacity) { c in
        withEvery("n", in: [0, 1, c / 2, c - 1] as Set) { n in
          withLifetimeTracking { tracker in
            var a = FixedArray<${capacity}, _>(layout: layout) { tracker.instance(for: $0) }
            a.append(addingCount: c) { target in
              expectEqual(target.freeCapacity, c)
              for i in layout.count ..< layout.count + n {
                target.append(tracker.instance(for: i))
              }
            }
            expectFixedArrayContents(
              a,
              equivalentTo: 0 ..< layout.count + n,
              by: { $0.payload == $1 },
              printer: { "\($0.payload)" })
          }
        }
      }
    }
% end
  }

  func test_append_moving_UnsafeMutableBufferPointer() {
% for (capacity, count) in layouts:
    do {
      let layout = ArrayLayout(capacity: ${capacity}, count: ${count})
      withEvery("c", in: 0 ..< layout.freeCapacity) { c in
        withLifetimeTracking { tracker in
          let additions = UnsafeMutableBufferPointer<LifetimeTracked<Int>>
            .allocate(capacity: c)
          for i in 0 ..< c {
            additions.initializeElement(
              at: i,
              to: tracker.instance(for: layout.count + i))
          }

          var a = FixedArray<${capacity}, _>(layout: layout) { tracker.instance(for: $0) }
          a.append(moving: additions)
  
          additions.deallocate()
  
          expectFixedArrayContents(
            a,
            equivalentTo: 0 ..< layout.count + c,
            by: { $0.payload == $1 },
            printer: { "\($0.payload)" })
        }
      }
    }
% end
  }

  func test_append_moving_OutputSpan() {
% for (capacity, count) in layouts:
    do {
      let layout = ArrayLayout(capacity: ${capacity}, count: ${count})
      withSomeArrayLayouts("spanLayout", ofCapacities: 0 ..< layout.freeCapacity) { spanLayout in
        withLifetimeTracking { tracker in
          var a = FixedArray<${capacity}, _>(layout: layout) { tracker.instance(for: $0) }
  
          tracker.withOutputSpan(
            layout: spanLayout,
            using: { layout.count + $0 }
          ) { span in
            a.append(moving: &span)
          }
  
          expectFixedArrayContents(
            a,
            equivalentTo: 0 ..< layout.count + spanLayout.count,
            by: { $0.payload == $1 },
            printer: { "\($0.payload)" })
        }
      }
    }
% end
  }
}

#endif
